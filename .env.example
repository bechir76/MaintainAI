# Copy to .env and adjust. Leave MISTRAL_API_KEY empty to run fully offline
# with the deterministic fake LLM and embedder.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
# auto | mistral | fake
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=30

POSTGRES_USER=maintainai
POSTGRES_PASSWORD=maintainai
POSTGRES_DB=maintainai
DATABASE_URL=postgresql://maintainai:maintainai@localhost:5432/maintainai

# Retrieval (leave RETRIEVAL_MIN_SCORE unset to use the per-provider default)
RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.75

# MCP server API keys, "key:role" pairs. Roles: viewer, technician.
# Change these for anything other than local development.
MCP_API_KEYS=viewer-dev-key:viewer,technician-dev-key:technician

# Keys the agent API uses when talking to the MCP server on behalf of each role
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_VIEWER_KEY=viewer-dev-key
MCP_TECHNICIAN_KEY=technician-dev-key
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=120

# Sensor simulator: machine:fault pairs. Faults: high_vibration, overheating,
# low_pressure, overcurrent
SIM_FAULTS=P-3:high_vibration,M-2:overheating
SIM_INTERVAL_SECONDS=5

# Replay real public datasets instead (run `make datasets` first):
# C-1 follows MetroPT-3 (UCI), P-3 follows the CWRU bearing data.
SIM_MODE=simulated
# Dataset seconds per wall-clock second (MetroPT-3), and the dataset time to start from.
# The default start is 3 h before the first reported air leak, so it shows after ~3 min.
REPLAY_SPEED=60
REPLAY_START=2020-04-17T21:00:00
# Minutes spent on each CWRU bearing condition (normal, then growing inner-race faults)
REPLAY_STAGE_MINUTES=3

# Host ports (change if they clash with something already running)
WEB_PORT=8080
API_PORT=8000
MCP_PORT=8001
DB_PORT=5432
